    "restore:db": "node scripts/restore.js",
    "backup:drill": "node scripts/restore-drill.js"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@napi-rs/canvas": "^0.1.100",
    "axios": "^1.15.2",
    "discord.js": "^14.28.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.13.0",
    "node-cron": "^4.2.1",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.11.3",
    "riffy": "1.0.12",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "engines": {
