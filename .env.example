# Copy this file to .env and replace placeholder values.

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
# Required: one Discord server ID. Other servers are ignored; slash commands register only here.
GUILD_ID=your_discord_guild_id_here
# On every start the bot deletes the application's global slash commands: it has none of its own, so they
# are leftovers of another program and answer "that command does not exist". Set to true to keep them.
# KEEP_GLOBAL_COMMANDS=false
# Your own Discord user ID (Discord settings -> Advanced -> Developer Mode, then "Copy User ID" on your profile).
# Several IDs are separated by commas. The dashboard's token login acts as the first one.
OWNER_IDS=

# Dashboard login, the simple way: a secret of at least 12 characters that you type on /dashboard/login.
# Needs OWNER_IDS above and nothing else. Empty = this login is off. Do not share it or post it anywhere.
# The link http://IP:PORT/masuk/<token> logs in without typing; it is as secret as the token itself.
DASHBOARD_TOKEN=

# Dashboard login through Discord (optional, instead of or next to the token).
# Register DASHBOARD_URL/dashboard/callback in the Discord developer portal.
# DASHBOARD_URL is the address only, without a path: https://bot.example.com or http://203.0.113.5:16954
# HTTPS is required except for localhost or 127.0.0.1 during development.
DISCORD_CLIENT_SECRET=
DASHBOARD_URL=
# Only for hosts that give you a plain http://ip:port address and no HTTPS.
# true = accept a public http:// DASHBOARD_URL for the Discord login. The login session then travels unencrypted:
# anyone on the network path can read it and use the dashboard until the session ends.
# Leave empty when an https:// address is available.
DASHBOARD_ALLOW_HTTP=

# Optional: Pterodactyl-compatible hosting panel client API. Server-side only.
HOSTING_PANEL_URL=
HOSTING_SERVER_ID=
HOSTING_API_KEY=

# Bot Runtime Configuration
NODE_ENV=production
# warn: startup report, warnings and errors. info: also ordinary events. debug: also one line per loaded file.
LOG_LEVEL=warn
# Set NO_COLOR=1 if the console shows codes such as [32m instead of colours.
NO_COLOR=
LOG_TO_FILE=false
SENTRY_DSN=

# Web/API Configuration
# The first usable value of WEB_PORT, PORT, SERVER_PORT is used; none set = 3000.
# Pterodactyl-style panels set SERVER_PORT by themselves; then leave PORT empty or delete the line,
# otherwise PORT wins and the bot listens on a port the panel does not forward.
PORT=3000
# WEB_PORT=
WEB_HOST=0.0.0.0
PORT_RETRY_ATTEMPTS=5
CORS_ORIGIN=*

# PostgreSQL Configuration (Primary Database)
# Required for startup: if PostgreSQL is unavailable, the bot stops; no RAM fallback.
# SQLite selection is not supported yet.
# Use a PostgreSQL URL from your provider. TLS defaults to certificate and hostname
# verification in production. For a private CA, set POSTGRES_SSL_CA_FILE.
# Explicit POSTGRES_SSL=false disables TLS (local trusted networks only).
# Public proxy logs showing "invalid length of startup packet" or "SSL without ALPN"
# are usually internet scanners — not your bot.
POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/zentixbot
POSTGRES_SSL=
POSTGRES_SSL_CA_FILE=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zentixbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword

# PostgreSQL Pool/Timeout Settings
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_CONNECTION_TIMEOUT=10000
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_RETRIES=3
POSTGRES_BACKOFF_BASE=100
POSTGRES_BACKOFF_MULTIPLIER=2

# Migration & Schema Settings
# AUTO_MIGRATE controls schema-ledger bootstrap; it no longer runs legacy key migration.
AUTO_MIGRATE=true
POSTGRES_MIGRATION_TABLE=schema_migrations
SCHEMA_VERSION=1
SCHEMA_VERSION_LABEL=baseline-v1

# Backup output directory (must be trusted and persistent)
BACKUP_DIR=./backups
# Retention is manual; automatic pruning is disabled. Restore CLI is temporarily disabled.

# Music (Lavalink + Riffy) — requires Lavalink v4 nodes
# Default: loads the six public TLS nodes listed in lavalink/nodes.json
# (vinster, trinium, nazha, serenetia, jirayu, millohost).
# Source of that list: https://lavalink.darrennathanael.com/SSL/Lavalink-SSL/
# To change nodes, edit that file or set LAVALINK_NODES below. Each node is host, port, password,
# secure and name; LAVALINK_URI and LAVALINK_NODE_NAME are not read by this bot.
# Public nodes belong to third parties and can go offline or change their password at any time.
# LAVALINK_NODES_FILE=lavalink/nodes.json
# Optional: override nodes as JSON array (takes priority over nodes file)
# LAVALINK_NODES=[{"host":"lavalink","port":2333,"password":"youshallnotpass","secure":false,"name":"Main"}]
# Self-hosted single node fallback (used only if nodes file/env array are absent):
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
# LAVALINK_NAME=Main
LAVALINK_SEARCH_PLATFORM=ytmsearch
LAVALINK_REST_VERSION=v4

# Optional Feature/API Keys
TMDB_API_KEY=

# AI foundation (Tahap 7): secrets remain server-side, never enter in dashboard
# The dashboard (AI Studio -> Provider & fallback) picks one primary provider and up to three backups.
# A provider whose key is empty here is skipped.
AI_GROQ_API_KEY=
AI_GEMINI_API_KEY=
AI_OPENROUTER_API_KEY=
AI_NVIDIA_API_KEY=

# Images (optional). AI_IMAGE_PROVIDER: openai (default when empty), cloudflare or pollinations.
#   openai        create and edit. Needs AI_IMAGE_API_KEY + AI_IMAGE_MODEL.
#   cloudflare    create only. Needs AI_CLOUDFLARE_API_TOKEN + AI_CLOUDFLARE_ACCOUNT_ID (Workers AI).
#                 AI_IMAGE_MODEL may stay empty (@cf/black-forest-labs/flux-1-schnell); the model picks the size.
#   pollinations  create only, no key. At most 768x768, JPEG with a logo, limited per IP address;
#                 the prompt becomes part of a web address that anyone holding it can open.
# Each provider reads only its own key. Edit always needs openai.
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=
AI_CLOUDFLARE_API_TOKEN=
AI_CLOUDFLARE_ACCOUNT_ID=

# Web search (optional). AI_SEARCH_PROVIDER: brave (default when empty; AI_BRAVE_SEARCH_KEY)
# or tavily (AI_TAVILY_API_KEY).
AI_SEARCH_PROVIDER=
AI_BRAVE_SEARCH_KEY=
AI_TAVILY_API_KEY=

# Speech-to-text (optional). AI_AUDIO_PROVIDER: openai (default when empty; AI_AUDIO_API_KEY +
# AI_AUDIO_MODEL, e.g. gpt-transcribe) or groq (uses AI_GROQ_API_KEY above; AI_AUDIO_MODEL may stay
# empty and then means whisper-large-v3-turbo).
AI_AUDIO_PROVIDER=
AI_AUDIO_API_KEY=
AI_AUDIO_MODEL=
